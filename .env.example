# Sentinel Configuration
SENTINEL_ENV=development
SENTINEL_SECRET_KEY=change-this-in-production-to-a-random-32-byte-hex-string
SENTINEL_DB_PATH=./sentinel.db
SENTINEL_COOKIE_SECURE=false
SENTINEL_CORS_ORIGINS=http://localhost:5173,http://localhost:8000,http://127.0.0.1:5173,http://127.0.0.1:8000
SENTINEL_PORT=8000
SENTINEL_DEMO_EXPIRE_HOURS=24
